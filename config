{
  "layer": "top",
  "position": "top",
  "margin": "8 8 0 8",
  "height": 40,
  "spacing": 1,
  "modules-left": [
    "custom/terminal",
    "hyprland/workspaces",
    "custom/nowplaying"
  ],
  "modules-center": [
    "custom/launcher",
    "clock",
    "custom/swaync"
  ],
  "modules-right": [
    "custom/updates",
    "battery",
    "pulseaudio",
    "group/right-other"
  ],
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "all-outputs": true,
    "disable-scroll": true,
    "persistent-workspaces": {
      "*": 5
    }
  },
  "custom/terminal": {
    "format": "󰣇",
    "tooltip": "Open terminal",
    "on-click": "bash -lc \"$HOME/.config/ml4w/settings/terminal.sh\""
  },
  "custom/launcher": {
    "format": "󰕰",
    "tooltip": "Open application launcher",
    "on-click": "bash -lc \"$HOME/.config/ml4w/scripts/ml4w-launcher\""
  },
  "clock": {
    "format": "<span font_family=\"monospace\">&#8197;&#8202;{:%H:%M\n%d %b}</span>",
    "tooltip-format": "{:%A, %d %B %Y}",
    "on-click": "qs ipc call calendar toggle",
    "on-click-right": "gnome-calendar"
  },
  "custom/swaync": {
    "exec": "swaync-client -swb",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚",
      "none": "󰂜",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂚",
      "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛"
    },
    "tooltip": true,
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw"
  },
  "custom/updates": {
    "exec": "$HOME/.config/ml4w/scripts/ml4w-check-system-updates",
    "return-type": "json",
    "format": "󰏖 {text}",
    "tooltip": true,
    "interval": 1800,
    "signal": 8,
    "on-click": "bash -lc \"$HOME/.config/ml4w/settings/installupdates.sh\""
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "󰂎 {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "tooltip-format": "{capacity}% · {timeTo}",
    "format-full": "󰁹 {capacity}%"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nClick: balanced · Middle-click: performance · Right-click: power saver",
    "format-icons": {
      "default": "󰾆",
      "performance": "󰓅",
      "balanced": "󰾅",
      "power-saver": "󰾆"
    },
    "on-click": "powerprofilesctl set balanced",
    "on-click-middle": "powerprofilesctl set performance",
    "on-click-right": "powerprofilesctl set power-saver"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ],
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "󰏲",
      "portable": "󰦧",
      "car": "󰄋",
      "HDMI": "󰡁",
      "speaker": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "tooltip-format": "{desc} · {volume}%"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 6
  },
  "custom/ml4w": {
    "format": "󰒓",
    "tooltip": "Toggle ML4W sidebar",
    "on-click": "qs ipc call sidebar toggle"
  },
  "custom/power": {
    "format": "",
    "tooltip": "Open power menu",
    "on-click": "ml4w-powermenu toggle"
  },
  "group/right-other": {
    "orientation": "horizontal",
    "modules": [
      "power-profiles-daemon",
      "tray",
      "custom/ml4w",
      "custom/power"
    ]
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 18,
    "icon-theme": "Morewaita",
    "spacing": 3,
    "on-click": "activate",
    "on-click-middle": "close",
    "tooltip-format": "{title}"
  },
  "custom/nowplaying": {
    "exec": "$HOME/.config/waybar/scripts/now-playing.sh",
    "interval": 2,
    "return-type": "json",
    "escape": true,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous"
  }
}